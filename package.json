{
  "name": "revendo",
  "version": "0.1.0",
  "private": true,
  "description": "ReVendo marketplace monorepo — Phase 1 scaffold",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @revendo/web",
    "dev:api": "npm run start:dev --workspace @revendo/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @revendo/api",
    "db:migrate": "npm run db:migrate --workspace @revendo/api",
    "db:seed": "npm run db:seed --workspace @revendo/api",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" }
}
