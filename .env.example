# ReVendo environment template — copy to .env for local development.
# Never commit real secrets. Production values come from the hosting secret manager.

# --- Runtime ---
NODE_ENV=development
LOG_LEVEL=info
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1
# Optional explicit CORS allow-list (comma-separated). Falls back to WEB_ORIGIN when empty.
CORS_ORIGINS=

# --- Database (local Docker Compose defaults only) ---
DATABASE_URL=mysql://revendo:revendo_local_only@localhost:3306/revendo
# --- Cache / queues (reserved for Phase 5+ jobs; Redis runs locally but is unused in Phase 1) ---
REDIS_URL=redis://localhost:6379

# --- Sessions (API-owned; browser uses HTTP-only Secure/SameSite cookies in production) ---
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# --- Cloudinary (placeholders; server-side signing only, Phase 3) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments: collection vs disbursement are separate flags, all disabled by default ---
# Reserved for later phases; no live payment code exists in Phase 1.
PAYMENTS_ENABLED=false
PAYMENTS_LIVE_ENABLED=false
PAYOUTS_ENABLED=false
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_B2C_ENABLED=false

# --- Notifications (not wired in Phase 1; MailHog defaults for local mail profile) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
