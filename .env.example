# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
WEB_PORT=3000
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_BASE_URL=http://localhost:3001/api/v1

# Local Docker Compose defaults only — replace passwords outside local development.
DATABASE_URL=mysql://revendo:revendo_local_only@localhost:3306/revendo
REDIS_URL=redis://localhost:6379

# Session security: configure a long random secret locally; production uses managed secret storage.
SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Cloudinary: intentionally blank until account access is configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Daraja is disabled by default. Sandbox credentials must be added deliberately.
PAYMENTS_ENABLED=false
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=
DARAJA_B2C_ENABLED=false

# Notifications are not wired in Phase 1.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
